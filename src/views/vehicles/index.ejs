<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Vehicles | Vehicle Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="admin-shell">
        <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">VR</span><span>Vehicle
                    Rental</span></a>
            <nav class="side-nav"><a class="side-link" href="/">Dashboard</a><a class="side-link active"
                    href="/vehicles">Vehicles</a><a class="side-link" href="/rentals">Rentals</a><a class="side-link"
                    href="/customers">Customers</a></nav>
        </aside>
        <section class="workspace">
            <header class="topbar">Vehicle Rental System</header>
            <main class="page-wrap">
                <div class="page-heading heading-actions">
                    <div>
                        <p class="eyebrow">Fleet</p>
                        <h1>Vehicles</h1>
                        <p>Manage the vehicles available for rental.</p>
                    </div><a class="btn btn-accent" href="/vehicles/add">Add Vehicle</a>
                </div>
                <section class="panel table-panel">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Brand</th>
                                    <th>Model</th>
                                    <th>Year</th>
                                    <th>License Plate</th>
                                    <th>Daily Rate</th>
                                    <th>Availability</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% vehicles.forEach((vehicle)=> { %><tr>
                                        <td>#<%= vehicle.id %>
                                        </td>
                                        <td class="fw-semibold">
                                            <%= vehicle.brand %>
                                        </td>
                                        <td>
                                            <%= vehicle.model %>
                                        </td>
                                        <td>
                                            <%= vehicle.year %>
                                        </td>
                                        <td><span class="plate">
                                                <%= vehicle.licensePlate %>
                                            </span></td>
                                        <td>$<%= vehicle.dailyRate %>
                                        </td>
                                        <td><span
                                                class="status <%= vehicle.isAvailable ? 'status-available' : 'status-rented' %>">
                                                <%= vehicle.isAvailable ? 'Available' : 'Rented' %>
                                            </span></td>
                                        <td class="text-end">
                                            <% if (vehicle.isAvailable) { %>
                                                <a class="btn btn-sm btn-primary" href="/rentals/add/<%= vehicle.id %>">Rent</a>
                                            <% } %>
                                            <a class="btn btn-sm btn-quiet" href="/vehicles/<%= vehicle.id %>">Edit</a>
                                            <form class="d-inline" action="/vehicles/<%= vehicle.id %>?_method=DELETE"
                                                method="POST">
                                                <button class="btn btn-sm btn-danger-quiet" type="submit">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% if (vehicles.length===0) { %>
                                            <tr>
                                                <td colspan="8" class="empty-state">No vehicles have been added yet.
                                                </td>
                                            </tr>
                                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </section>
    </div>
</body>

</html>

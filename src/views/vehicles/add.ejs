<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Add Vehicle | Vehicle Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="admin-shell">
        <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">VR</span><span>Vehicle
                    Rental</span></a>
            <nav class="side-nav"><a class="side-link" href="/">Dashboard</a><a class="side-link active"
                    href="/vehicles">Vehicles</a><a class="side-link" href="/rentals">Rentals</a><a class="side-link"
                    href="/customer">Customers</a></nav>
        </aside>
        <section class="workspace">
            <header class="topbar">Vehicle Rental System</header>
            <main class="page-wrap">
                <div class="page-heading">
                    <p class="eyebrow">Fleet</p>
                    <h1>Add Vehicle</h1>
                    <p>Add a vehicle to your rental fleet.</p>
                </div>
                <section class="panel form-panel">
                    <form method="post" action="/vehicles">
                        <div class="row g-4">
                            <div class="col-md-6"><label class="form-label" for="brand">Brand</label><input
                                    class="form-control" id="brand" name="brand" type="text"></div>
                            <div class="col-md-6"><label class="form-label" for="model">Model</label><input
                                    class="form-control" id="model" name="model" type="text"></div>
                            <div class="col-md-4"><label class="form-label" for="year">Year</label><input
                                    class="form-control" id="year" name="year" type="number"></div>
                            <div class="col-md-4"><label class="form-label" for="licensePlate">License
                                    Plate</label><input class="form-control" id="licensePlate" name="licensePlate"
                                    type="text"></div>
                            <div class="col-md-4"><label class="form-label" for="dailyRate">Daily Rate</label><input
                                    class="form-control" id="dailyRate" name="dailyRate" type="number" step="0.01">
                            </div>
                        </div>
                        <div class="form-actions"><a class="btn btn-quiet" href="/vehicles">Cancel</a><button
                                class="btn btn-accent" type="submit">Save Vehicle</button></div>
                    </form>
                </section>
            </main>
        </section>
    </div>
</body>

</html>
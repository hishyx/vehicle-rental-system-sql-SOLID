<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rent Vehicle | Vehicle Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="admin-shell">
        <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">VR</span><span>Vehicle
                    Rental</span></a>
            <nav class="side-nav"><a class="side-link" href="/">Dashboard</a><a class="side-link"
                    href="/vehicles">Vehicles</a><a class="side-link active" href="/rentals">Rentals</a><a
                    class="side-link" href="/customers">Customers</a></nav>
        </aside>
        <section class="workspace">
            <header class="topbar">Vehicle Rental System</header>
            <main class="page-wrap">
                <div class="page-heading">
                    <p class="eyebrow">New Rental</p>
                    <h1>Rent Vehicle</h1>
                    <p>Enter the customer's details to start a rental.</p>
                </div>
                <section class="panel p-4">
                    <form action="/rentals/add/<%= vehicleId %>" method="POST" class="row g-3">
                        <div class="col-12">
                            <label class="form-label" for="vehicleId">Vehicle ID</label>
                            <input class="form-control" id="vehicleId" type="number" value="<%= vehicleId %>"
                                readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="customerName">User name</label>
                            <input class="form-control" id="customerName" name="name" type="text" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="customerEmail">User email</label>
                            <input class="form-control" id="customerEmail" name="email" type="email" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="customerPhone">User phone</label>
                            <input class="form-control" id="customerPhone" name="phone" type="tel" required>
                        </div>
                        <div class="col-12 d-flex gap-2">
                            <button class="btn btn-primary" type="submit">Rent Vehicle</button>
                            <a class="btn btn-quiet" href="/vehicles">Cancel</a>
                        </div>
                    </form>
                </section>
            </main>
        </section>
    </div>
</body>

</html>

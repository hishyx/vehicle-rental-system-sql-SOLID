<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Rentals | Vehicle Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="admin-shell">
        <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">VR</span><span>Vehicle
                    Rental</span></a>
            <nav class="side-nav"><a class="side-link" href="/">Dashboard</a><a class="side-link"
                    href="/vehicles">Vehicles</a><a class="side-link active" href="/rentals">Rentals</a><a
                    class="side-link" href="/customers">Customers</a></nav>
        </aside>
        <section class="workspace">
            <header class="topbar">Vehicle Rental System</header>
            <main class="page-wrap">
                <div class="page-heading">
                    <p class="eyebrow">Operations</p>
                    <h1>Rentals</h1>
                    <p>Track active and completed vehicle rentals.</p>
                </div>
                <section class="panel table-panel">
                    <div class="table-responsive">
                        <table class="table table-dark align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Rental ID</th>
                                    <th>Customer</th>
                                    <th>Vehicle</th>
                                    <th>Rent Date</th>
                                    <th>Return Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% rentals.forEach((rental)=> { %><tr>
                                        <td>#<%= rental.id %>
                                        </td>
                                        <td class="fw-semibold">
                                            <%= rental.customerName %>
                                        </td>
                                        <td>
                                            <%= rental.vehicleName %>
                                        </td>
                                        <td>
                                            <%= new Date(rental.startDate).toLocaleDateString("en-GB"); %>
                                        </td>
                                        <td>
                                            <%= new Date(rental.endDate).toLocaleDateString("en-GB")|| '—' %>
                                        </td>
                                        <td><span class="status status-rented">
                                                <%= rental.status %>
                                            </span></td>
                                        <td>
                                            <form action="/rentals/<%= rental.id %>/return?_method=PATCH" method="POST">
                                                <button type="submit" class="btn btn-sm btn-primary">Return</button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% if (rentals.length===0) { %>
                                            <tr>
                                                <td colspan="7" class="empty-state">No rentals found.</td>
                                            </tr>
                                            <% } %>
                            </tbody>
                        </table>
                    </div>
                </section>
            </main>
        </section>
    </div>
</body>

</html>
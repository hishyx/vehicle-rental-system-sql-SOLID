<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard | Vehicle Rental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="admin-shell">
        <aside class="sidebar"><a class="brand" href="/"><span class="brand-mark">VR</span><span>Vehicle
                    Rental</span></a>
            <nav class="side-nav"><a class="side-link active" href="/">Dashboard</a><a class="side-link"
                    href="/vehicles">Vehicles</a><a class="side-link" href="/rentals">Rentals</a><a class="side-link"
                    href="/customer">Customers</a></nav>
        </aside>
        <section class="workspace">
            <header class="topbar">Vehicle Rental System</header>
            <main class="page-wrap">
                <div class="page-heading">
                    <p class="eyebrow">Overview</p>
                    <h1>Dashboard</h1>
                    <p>Business snapshot and fleet availability.</p>
                </div>
                <div class="row g-3 g-xl-4">
                    <div class="col-sm-6 col-xl">
                        <article class="stat-card"><span>Total Vehicles</span><strong>
                                <%= totalVehicles %>
                            </strong></article>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <article class="stat-card accent"><span>Available Vehicles</span><strong>
                                <%= availableVehicles %>
                            </strong></article>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <article class="stat-card"><span>Rented Vehicles</span><strong>
                                <%= rentedVehicles %>
                            </strong></article>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <article class="stat-card"><span>Total Customers</span><strong>
                                <%= totalCustomers %>
                            </strong></article>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <article class="stat-card"><span>Active Rentals</span><strong>
                                <%= activeRentals %>
                            </strong></article>
                    </div>
                </div>
            </main>
        </section>
    </div>
</body>

</html>